# ── Data (downloaded separately, very large) ──
antarctica/data/
data

# ISMIP7 forcing data (mirrored from Globus)
ISMIP7/

# ── Generated artifacts ──
# Ignore mesh dir *contents* (huge .msh/.h5/.pos) but keep the tiny
# boundary-id sidecars. NB: a negation under "antarctica/mesh/" (the dir
# form) would be a no-op — git won't descend into an excluded directory to
# reconsider files — so we must exclude the contents with "mesh/*" instead.
antarctica/mesh/*
!antarctica/mesh/boundary_ids*.json
antarctica/results/
antarctica/archive/
antarctica/figs/*.png
antarctica/figs/*.csv

# Gmsh intermediates
*.pos
*_raw.msh

# Firedrake checkpoints
*.h5

# ── Protocol PDFs (keep in repo for reference) ──
# protocol/

# ── Credentials / tokens (never commit) ──
.ismip7_globus_tokens.json
.netrc
.urs_cookies
.dodsrc
earthaccess_*.json

# ── Python ──
*.pyc
__pycache__/
*.egg-info/

# ── Editor / OS ──
*.sw?
*.un~
*.DS_Store
.ipynb_checkpoints/

# ── Other ──
UaSource/
*.tar.gz
download_log.txt
