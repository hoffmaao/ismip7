# ── Data (downloaded separately, very large) ──
antarctica/data/
data

# ISMIP7 forcing data (mirrored from Globus)
ISMIP7/

# ── Generated artifacts ──
# Ignore the whole mesh dir (the .msh files are large and regenerated
# locally), but keep the tiny boundary_ids*.json sidecars: mesh_antarctica.py
# now names them after the exact mesh they were built from
# (boundary_ids_antarctica_<COARSE>_<FINE>_buffered<N>.json), so a committed
# sidecar always matches the mesh it documents instead of silently
# mismatching a different build.
antarctica/mesh/*
!antarctica/mesh/boundary_ids*.json
# The pre-per-mesh legacy set stays untracked: these names carry no mesh stem,
# and boundary_ids.json in particular is the shared-fallback file (overwritten
# by every mesh build) that is exactly the stale-shared-file vector the
# per-mesh convention removes. The negation above un-ignores every sidecar
# name, so without these an `add -A` sweeps them back in.
antarctica/mesh/boundary_ids.json
antarctica/mesh/boundary_ids_2500.json
antarctica/mesh/boundary_ids_aniso.json
antarctica/mesh/boundary_ids_buffered.json
antarctica/results/
antarctica/archive/
antarctica/figs/*.png
antarctica/figs/*.csv
antarctica/*.err
antarctica/*.txt
# `make matrix` writes here unless MATRIX_OUTPUT names a file; the committed
# matrices are the named ones (TIMING_MATRIX_<SITE>_<SOLVER>.md).
antarctica/TIMING_MATRIX.md

# Batch runners: per-user site settings (sites/local.env.example is the
# tracked blank) and the job logs submit.sh collects at the repo root.
antarctica/scripts/batch_runners/sites/local.env
/logs/

# Gmsh intermediates
*.pos
*_raw.msh

# Firedrake checkpoints
*.h5

# ── Protocol PDFs (keep in repo for reference) ──
# protocol/

# ── Credentials / tokens (never commit) ──
.ismip7_globus_tokens.json
.netrc
.urs_cookies
.dodsrc
earthaccess_*.json

# ── Python ──
*.pyc
__pycache__/
*.egg-info/

# ── Editor / OS ──
*.sw?
*.un~
*.DS_Store
.ipynb_checkpoints/


# ── Other ──
UaSource/
*.tar.gz
download_log.txt

# Rendered movie frames from scripts/plot_movie.py (regenerable outputs)
antarctica/figs/movie_*/
# MAP field figures from scripts/plot_map.py (regenerable outputs); the
# antarctica/figs/*.png rule above matches direct children only, so this
# subdirectory needs its own line.
antarctica/figs/maps/
