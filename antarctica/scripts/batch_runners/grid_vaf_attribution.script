#!/bin/bash

# The organisers' volume above flotation on the 8 km grid set against the
# model's, for each state a list names, as is and with its shelves thinned,
# removed and its grounding line retreated (issue #99). Serial and read-only;
# scripts/grid_vaf_attribution.py says what it computes.
#
# From antarctica/ (measured on Quartz, September 2026: 6 min for a 1 km mesh
# of 3.7 million cells, most of it loading the state and building the overlap
# operator once; a later state on the same mesh reuses the operator):
#
#   scripts/batch_runners/submit.sh script scripts/batch_runners/grid_vaf_attribution.script \
#       --cd antarctica --queue short --tasks 1 --mem 96G --time 03:00:00 \
#       ISMIP7_GRIDVAF_LIST=<file of "LABEL CHECKPOINT" lines> ISMIP7_GRIDVAF_OUT=<dir>
#
# A CHECKPOINT is a MAP, a timing cache or one year of a run's ISMIP7 annual
# output (<run>_ismip7_annual_<year>.h5). ISMIP7_GRIDVAF_OUT holds the
# records, the pixel planes and the cached operators.

#SBATCH -o ant_gridvaf_%j.txt
#SBATCH -e ant_gridvaf_%j.err

# Resources, the account and the partition come from submit.sh, which reads
# this cluster's sites/<name>.sh; nothing here names a cluster.
cd "${SLURM_SUBMIT_DIR:-.}"
. scripts/batch_runners/site_core.sh
ismip7_activate
ismip7_banner

python -u scripts/grid_vaf_attribution.py \
    --out "${ISMIP7_GRIDVAF_OUT:?ISMIP7_GRIDVAF_OUT is required (records and cached operators)}" \
    --list "${ISMIP7_GRIDVAF_LIST:?ISMIP7_GRIDVAF_LIST is required (a file of LABEL CHECKPOINT lines)}"
