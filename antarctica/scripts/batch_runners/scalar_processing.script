#!/bin/bash

# The organisers' scalar processing over one submitted experiment (issue #13):
# ismip7-scalars 0.1.0 writes the sea-level contributions sla20, slg20 and
# slvaf and its own copies of the ten request scalars, and
# scripts/compare_scalars.py sets those against the model's. Serial. The job
# ends with the tool's status when the tool fails and with the comparison's
# otherwise (0 every gate holds, 1 a gate fails, 2 an input is missing), so
# sacct carries the verdict.
#
# From antarctica/ (measured on Quartz, September 2026: 3 min and at most
# 3.7 GiB for a 286-year experiment on the 8 km grid):
#
#   scripts/batch_runners/submit.sh script scripts/batch_runners/scalar_processing.script \
#       --cd antarctica --queue short --tasks 1 --mem 16G --time 01:00:00 \
#       ISMIP7_TOOLS_VENV=<venv> ISMIP7_SCALAR_TREE=<the writer's --out-dir> \
#       ISMIP7_SCALAR_EXPERIMENT=ssp585 ISMIP7_SCALAR_CONFIGID=C007 \
#       ISMIP7_SCALAR_REFYEAR=2016 ISMIP7_SCALAR_OUT=<dir> \
#       ISMIP7_SCALAR_NATIVE_CSV=$PWD/results/<run>_ismip7_scalars.csv \
#       ISMIP7_SCALAR_OVERLAP=$PWD/results/<run>_ismip7_annual.h5.overlap.npz
#
# ISMIP7_TOOLS_VENV is a Python 3.11+ venv holding ismip7-scalars and
# isschecker (antarctica/README.md, "From a finished run to a submission"). It
# is called by path with the Firedrake environment's PYTHONPATH scrubbed, and
# the comparison runs under the job's own python.
#
# ISMIP7_SCALAR_NATIVE_AF2=1 says the run's native scalars integrate over true
# area, as a forward with the area factor writes them. The writer stamps which
# area a tree's scalars carry, and the comparison exits 2 when the knob
# disagrees with the stamp.
#
# A run that is its own reference names the stamped year of its first state,
# 2016 for a run from 2015. A projection paired with its historical names
# ISMIP7_SCALAR_HIST=historical and ISMIP7_SCALAR_HIST_CONFIGID=C001 (C002 for
# MRI-ESM2-0) and no year: the tool looks a year up in the historical first and
# then in the projection, so a stray 2016 would quietly become the reference.
#
# Nothing is written into the submission tree. params.nc, the tool's files
# (which carry the submission's own file names) and the comparison all go
# under ISMIP7_SCALAR_OUT. ISMIP7_SCALAR_DATAPATH holds the auxiliary grids
# (download_forcing.py --scalar-processing puts them under the checkout).

#SBATCH -o ant_scalars_%j.txt
#SBATCH -e ant_scalars_%j.err

# Resources, the account and the partition come from submit.sh, which reads
# this cluster's sites/<name>.sh; nothing here names a cluster.
cd "${SLURM_SUBMIT_DIR:-.}"
. scripts/batch_runners/site_core.sh
ismip7_activate
ismip7_banner

venv="${ISMIP7_TOOLS_VENV:?ISMIP7_TOOLS_VENV is required (a Python 3.11+ venv with ismip7-scalars)}"
tree="${ISMIP7_SCALAR_TREE:?ISMIP7_SCALAR_TREE is required (the --out-dir given to the writer, holding AIS/)}"
exp="${ISMIP7_SCALAR_EXPERIMENT:?ISMIP7_SCALAR_EXPERIMENT is required (ssp585, ctrl, ...)}"
cfg="${ISMIP7_SCALAR_CONFIGID:?ISMIP7_SCALAR_CONFIGID is required (C007, C009, ...)}"
out="${ISMIP7_SCALAR_OUT:?ISMIP7_SCALAR_OUT is required (params, tool output and comparison go there)}"
hist="${ISMIP7_SCALAR_HIST:-${exp}}"
histcfg="${ISMIP7_SCALAR_HIST_CONFIGID:-${cfg}}"
data="${ISMIP7_SCALAR_DATAPATH:-${ISMIP7_REPO}/ISMIP7/Output-Processing/Data/AIS}"
source_id="${ISMIP7_SOURCE_ID:-RICE}"
ism_id="${ISMIP7_ISM_ID:-icepack2}"
esm="${ISMIP7_SCALAR_ESM:-CESM2-WACCM}"
case "${cfg}" in
    E*) group=ESM ;;
    P*) group=PPE ;;
    *) group=CORE ;;
esac
sub="${tree}/AIS/${source_id}/${ism_id}/${group}"

for f in "${venv}/bin/ismip7-scalars" "${sub}/${cfg}" "${data}"; do
    [ -e "${f}" ] || { echo "not found: ${f}" >&2; exit 2; }
done
for f in "${ISMIP7_SCALAR_NATIVE_CSV:-}" "${ISMIP7_SCALAR_OVERLAP:-}"; do
    [ -z "${f}" ] || [ -f "${f}" ] || { echo "not found: ${f}" >&2; exit 2; }
done

if [ "${hist}" = "${exp}" ] && [ "${histcfg}" = "${cfg}" ]; then
    year="${ISMIP7_SCALAR_REFYEAR:?ISMIP7_SCALAR_REFYEAR is required for a run that is its own reference (the stamped year of its first state, 2016 for a run from 2015)}"
    tool_ref=(--refyear "${year}")
    cmp_ref=(--refyear "${year}")
else
    if [ -n "${ISMIP7_SCALAR_REFYEAR:-}" ]; then
        echo "ISMIP7_SCALAR_REFYEAR is refused when the run is paired with ${hist} ${histcfg}:" \
             "the reference is that run's last state" >&2
        exit 2
    fi
    tool_ref=()
    cmp_ref=(--hist-submission "${sub}/${histcfg}")
fi

tools() {   # a tool of the venv, clear of the Firedrake environment
    local name=$1
    shift
    env -u PYTHONPATH -u PYTHONHOME -u VIRTUAL_ENV "${venv}/bin/${name}" "$@"
}
sha() { { sha256sum "$1" 2>/dev/null || shasum -a 256 "$1"; } | cut -d' ' -f1; }

commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
tool_version="$(tools ismip7-scalars --version 2>&1)"
checker_version="$(tools python -c 'import isschecker; print(isschecker.__version__)' 2>&1)"
echo "    commit  ${commit}"
echo "    tool    ${tool_version}; isschecker ${checker_version}"
notes=(--note "commit ${commit}" --note "${tool_version}, isschecker ${checker_version}")
for f in "${data}"/*_AIS_08000m_*.nc; do
    [ -f "${f}" ] || continue
    echo "    grid    $(basename "${f}")  sha256 $(sha "${f}")"
    notes+=(--note "$(basename "${f}") sha256 $(sha "${f}")")
done

# the model's densities; compare_scalars.py refuses any others
tools ismip7-scalars-set-params --region AIS --group "${source_id}" --model "${ism_id}" \
    --rhoi 917 --rhow 1024 --rhof 1000 --modelpath "${out}/params"
status=$?
[ "${status}" -eq 0 ] || { echo "ismip7-scalars-set-params exit status: ${status}"; exit "${status}"; }

tools ismip7-scalars --region AIS --group "${source_id}" --model "${ism_id}" --modelid m001 \
    --esm "${esm}" --forcingid f001 --experiment "${exp}" --configid "${cfg}" \
    --exp-group "${group}" --hist "${hist}" --hist-configid "${histcfg}" \
    ${tool_ref[@]+"${tool_ref[@]}"} --datapath "${data}" --modelpath "${tree}/AIS" \
    --params-path "${out}/params" --outpath "${out}/tool"
status=$?
echo "ismip7-scalars exit status: ${status}"
[ "${status}" -eq 0 ] || exit "${status}"

args=(--submission "${sub}/${cfg}" --tool "${out}/tool/nc/AIS/${source_id}/${ism_id}/${group}/${cfg}"
      --datapath "${data}" --params "${out}/params/${source_id}/${ism_id}/params.nc"
      "${cmp_ref[@]}" --label "${ISMIP7_SCALAR_LABEL:-${exp} ${cfg}}" "${notes[@]}"
      --out-csv "${out}/compare/comparison.csv" --out-md "${out}/compare/comparison.md")
[ -z "${ISMIP7_SCALAR_NATIVE_CSV:-}" ] || args+=(--native-csv "${ISMIP7_SCALAR_NATIVE_CSV}")
[ -z "${ISMIP7_SCALAR_OVERLAP:-}" ] || args+=(--overlap "${ISMIP7_SCALAR_OVERLAP}")
[ "${ISMIP7_SCALAR_NATIVE_AF2:-0}" = 0 ] || args+=(--native-af2)
python -u scripts/compare_scalars.py "${args[@]}"
status=$?
echo "compare_scalars exit status: ${status}"
exit "${status}"
