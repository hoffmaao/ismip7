# Per-user settings. Copy to sites/local.env (git ignores it) and keep only the
# lines you need. site_core.sh reads it BEFORE the site file, so anything set
# here beats the cluster's default.
#
# Write every line as VAR="${VAR:-value}". A plain VAR=value would also beat a
# value given for one submission (`ISMIP7_ACCOUNT=other submit.sh ...`) and the
# ISMIP7_SITE / ISMIP7_REPO a running job inherits from the submission.
#
# The site files describe clusters; this file describes you. Anything a second
# person on the same cluster would set differently belongs here.

# Pin the site when the hostname does not identify it (a compute node, a
# laptop): the name of a file in sites/, without .sh.
#ISMIP7_SITE="${ISMIP7_SITE:-iu_quartz}"

# The allocation to charge, when it is not the site file's.
#ISMIP7_ACCOUNT="${ISMIP7_ACCOUNT:-r00000}"

# Your own Firedrake build, when the site's is not yours to read.
#ISMIP7_FIREDRAKE="${ISMIP7_FIREDRAKE:-$HOME/sw/firedrake/bin/activate}"
#ISMIP7_MODULE_USE="${ISMIP7_MODULE_USE:-$HOME/modulefiles}"

# The filesystem that holds your forcing tree and scratch output.
#ISMIP7_WORK="${ISMIP7_WORK:-/path/to/project/share}"
#ISMIP7_DATA_ROOT="${ISMIP7_DATA_ROOT:-$ISMIP7_WORK/ISMIP7/AIS}"
