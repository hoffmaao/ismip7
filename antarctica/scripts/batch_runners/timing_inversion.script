#!/bin/bash

#SBATCH -J ant_timing_inv
#SBATCH -p general
#SBATCH -o ant_timing_inv%j.txt
#SBATCH -e ant_timing_inv%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dlilien@iu.edu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --time=48:00:00
#SBATCH --mem=32G
#SBATCH -A r00905

#Load any modules that your program needs
module use /N/u/dlilien/Quartz/modulefiles
module load gnu/9.3.0
module load openmpi/4.0.5
module load python/3.12.4
module load zlib/1.2.13
module load hdf5/1.12
module load openblas/0.3.13
module load patchelf/0.18.0
module load petsc/3.24.0
module load firedrake/2025.10
. /N/u/dlilien/Quartz/sw/firedrake/2025.10/firedrake/bin/activate

cd "${SLURM_SUBMIT_DIR:-.}"

ISMIP7_LC=2500 ISMIP7_LC_COARSE=25000 ISMIP7_BUFFER_M=20000 \
  srun -n 12 python -u scripts/inversion_icepack2.py
