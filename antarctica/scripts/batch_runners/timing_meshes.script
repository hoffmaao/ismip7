#!/bin/bash

# Build the timing-matrix meshes in a short, single-rank allocation.

#SBATCH -o ant_timing_mesh%j.txt
#SBATCH -e ant_timing_mesh%j.err

# Resources, the account and the partition come from submit.sh, which reads
# this cluster's sites/<name>.sh; nothing here names a cluster. Submit with
#   scripts/batch_runners/submit.sh script scripts/batch_runners/timing_meshes.script --cd antarctica ...
# as antarctica/Makefile and manage_timing_campaign.py do.
cd "${SLURM_SUBMIT_DIR:-.}"
# The site half only: every model setting arrives through --export, and
# site_env.sh's defaults (ISMIP7_MESH, ISMIP7_FRICTION) are not this job's.
. scripts/batch_runners/site_core.sh
ismip7_activate
ismip7_persistent_jit_cache
ismip7_banner

IFS=: read -ra lcs <<< "${TIMING_LCS:-500:1000:2000:2500:5000}"
IFS=: read -ra ratios <<< "${TIMING_RATIOS:-20:10}"
buffer="${TIMING_BUFFER:-20000}"

for lc in "${lcs[@]}"; do
  for ratio in "${ratios[@]}"; do
    lc_coarse=$((lc * ratio))
    mesh="mesh/antarctica_${lc_coarse}_${lc}_buffered${buffer}.msh"
    bndids="mesh/boundary_ids_antarctica_${lc_coarse}_${lc}_buffered${buffer}.json"
    if [ -f "${mesh}" ] && [ -f "${bndids}" ]; then
      echo "skip ${mesh}"
      continue
    fi
    python -u scripts/mesh_antarctica.py \
      --lc "${lc}" --lc-coarse "${lc_coarse}" --buffer-m "${buffer}"
  done
done
