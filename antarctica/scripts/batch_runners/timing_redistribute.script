#!/bin/bash

# Rewrite the shared timing MAP with a one-rank allocation so all transient
# jobs can load it with their own MPI size.

#SBATCH -o ant_timing_redist%j.txt
#SBATCH -e ant_timing_redist%j.err

# Resources, the account and the partition come from submit.sh, which reads
# this cluster's sites/<name>.sh; nothing here names a cluster. Submit with
#   scripts/batch_runners/submit.sh script scripts/batch_runners/timing_redistribute.script --cd antarctica ...
# as antarctica/Makefile and manage_timing_campaign.py do.
cd "${SLURM_SUBMIT_DIR:-.}"
# The site half only: every model setting arrives through --export, and
# site_env.sh's defaults (ISMIP7_MESH, ISMIP7_FRICTION) are not this job's.
. scripts/batch_runners/site_core.sh
ismip7_activate
ismip7_persistent_jit_cache
ismip7_banner

input="${TIMING_REDISTRIBUTE_INPUT:?TIMING_REDISTRIBUTE_INPUT is required}"
output="${TIMING_REDISTRIBUTE_OUTPUT:?TIMING_REDISTRIBUTE_OUTPUT is required}"
if [ "${input}" = "${output}" ]; then
    echo "redistribution input and output must be distinct" >&2
    exit 2
fi
ismip7_mpirun 1 python -u scripts/redistribute_checkpoint.py \
  --input "${input}" --output "${output}"
